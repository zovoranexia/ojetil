# ─────────────────────────────────────────────────────────────────────────────
# OJETIL WebApp — environment template
#
# Do not fill this file by hand for local development. Run:
#     npm run setup:env
# which copies it to .env and replaces every __GENERATE_*__ marker with a fresh
# cryptographically random value. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the site (absolute links, Auth.js callbacks, sitemap.xml,
# robots.txt and schema.org data). Must be the real domain in production.
APP_URL="http://localhost:3000"

# ── PostgreSQL (docker-compose.yml reads these too) ──────────────────────────
POSTGRES_USER="ojetil"
POSTGRES_PASSWORD="__GENERATE_DB_PASSWORD__"
POSTGRES_DB="ojetil"
POSTGRES_PORT="54329"
# Keep in sync with the three values above: if you change POSTGRES_PORT (e.g. a
# port clash), change the port here too — Prisma does not read POSTGRES_PORT.
DATABASE_URL="postgresql://ojetil:__GENERATE_DB_PASSWORD__@localhost:54329/ojetil?schema=public"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Signs/encrypts the HTTP-only session cookie. 32 random bytes, base64.
AUTH_SECRET="__GENERATE_KEY__"
AUTH_TRUST_HOST="true"

# ── Client IP detection (rate limits + audit log) ────────────────────────────
# Number of reverse proxies in front of the app that APPEND the client address
# to X-Forwarded-For. The client IP is read that many entries from the right;
# anything further left is client-supplied and ignored. With nginx use
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;   → 1
# (add 1 per extra layer, e.g. Cloudflare → nginx → app = 2).
# Always run production behind a proxy: without one, Next.js passes a
# client-sent X-Forwarded-For through unchanged.
TRUSTED_PROXY_HOPS="1"

# ── PII encryption (AES-256-GCM) ─────────────────────────────────────────────
# Keyring of "version:base64Key" pairs, comma-separated. Each key = 32 bytes.
# To rotate: append "2:<newKey>", set PII_ACTIVE_KEY_VERSION=2, keep "1:" so
# older rows stay decryptable until they are re-encrypted.
PII_ENCRYPTION_KEYS="1:__GENERATE_KEY__"
PII_ACTIVE_KEY_VERSION="1"
# HMAC key for the national-ID blind index (duplicate detection without decrypting).
# Never rotate without re-indexing every member row.
PII_BLIND_INDEX_KEY="__GENERATE_KEY__"

# ── Uploads ──────────────────────────────────────────────────────────────────
# Profile photos are stored outside /public and served through an authorised route.
UPLOAD_DIR="./storage/uploads"
MAX_PROFILE_PHOTO_BYTES="1048576"
# Public editorial images (news covers + images inside articles). Re-encoded to
# WebP by sharp, served at /uploads/… (by the app, or directly by Nginx in
# production). Never point this at UPLOAD_DIR: member photos stay private.
PUBLIC_UPLOAD_DIR="./storage/public-uploads"
MAX_IMAGE_UPLOAD_BYTES="5242880"
# Media library: PDF, MP4 and MP3 files (public, under PUBLIC_UPLOAD_DIR/media).
# Max 20 MB; keep Nginx client_max_body_size above it. Long videos: use "Add video by link".
MAX_MEDIA_FILE_BYTES="20971520"
# PDF library (Documents module). Kept outside /public; only PUBLISHED documents
# are downloadable, through /documents/<slug>.pdf. Max 20 MB (keep Nginx's
# client_max_body_size above this value).
DOCUMENT_DIR="./storage/documents"
MAX_DOCUMENT_BYTES="10485760"

# ── Seed (development only) ──────────────────────────────────────────────────
# Shared password for the 4 demo admin accounts created by prisma/seed.ts.
# The seed refuses to run when NODE_ENV=production unless ALLOW_PRODUCTION_SEED=true.
SEED_DEMO_PASSWORD="__GENERATE_PASSWORD__"

# ── Outgoing email (optional) ───────────────────────────────────────────────
# Without SMTP_HOST nothing is sent (registrations still work). In development,
# set MAIL_PREVIEW_DIR to write each email as an .html file you can open.
SMTP_HOST=""
SMTP_PORT="587"
# "true" = implicit TLS (465); otherwise STARTTLS is required.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="OJETIL <no-reply@localhost>"
MAIL_REPLY_TO=""
# Staff told about new member registrations and contact messages (comma-separated).
ADMIN_NOTIFY_EMAILS=""
MAIL_PREVIEW_DIR="./storage/mail-preview"
