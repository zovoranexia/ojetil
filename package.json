{
  "name": "ojetil-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "OJETIL — Organização da Juventude e dos Estudantes de Timor-Leste. Public website, member registration portal and RBAC backoffice.",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-messages.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "news:md-to-html": "tsx --conditions=react-server scripts/migrate-news-markdown-to-html.ts",
    "media:backfill": "tsx --conditions=react-server scripts/media-backfill.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.15.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.92.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
